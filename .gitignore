# Dependencies, builds and editor state
node_modules/
dist/
build/
.DS_Store
.idea/
.vscode/

# Unused generated Shopify template; retain only minimal app metadata
/shopify-app/*
!/shopify-app/gisting-order-agent/
/shopify-app/gisting-order-agent/*
!/shopify-app/gisting-order-agent/shopify.app.toml
!/shopify-app/gisting-order-agent/AGENTS.md
!/shopify-app/gisting-order-agent/package.json

