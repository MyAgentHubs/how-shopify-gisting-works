# Local Python environment (the current workspace itself contains a venv)
/bin/
/lib/
/include/
/pyvenv.cfg
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Private data, model weights and generated experiment results
/artifacts/
*.safetensors
*.pt
*.pth
*.bin
*.onnx
*.gguf
*.log

# Credentials and local agent/CLI state
.env
.env.*
